# Parametry środowiska. Program nie wczytuje tego pliku automatycznie.
# Skopiuj potrzebne wartości do zmiennych środowiskowych systemu lub procesu.
RACECOACH_DATA=
RACECOACH_SECURE_COOKIES=0
# Oddzielna instalacja serwera AC przeznaczona wyłącznie dla RaceCoach:
RACECOACH_SERVER_DIR=
RACECOACH_SERVER_EXECUTABLE=
RACECOACH_SERVER_HOST=
RACECOACH_SERVER_PORT=9600
# kunos | assettoserver; puste = wykrycie po nazwie pliku (AssettoServer.exe obsługuje deszcz CSP):
RACECOACH_SERVER_KIND=
# Lokalny port RCON AssettoServer do sterowania deszczem (tylko 127.0.0.1):
RACECOACH_SERVER_RCON_PORT=9610
# Opcjonalny, samodzielnie wdrożony most do kontrolera CSP:
RACECOACH_WEATHER_BRIDGE=
RACECOACH_WEATHER_TOKEN=
# Tylko na komputerze stanowiska; token jest wydawany w panelu:
RACECOACH_AGENT_TOKEN=
